PORT=4000
DATABASE_URL=postgres://bookmyseat@127.0.0.1:5433/bookmyseat
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
DB_POOL_MAX=20
# PESSIMISTIC (SELECT ... FOR UPDATE) or OPTIMISTIC (version-checked conditional UPDATE)
SEAT_LOCK_STRATEGY=PESSIMISTIC
SEAT_HOLD_MINUTES=5
CANCELLATION_CUTOFF_MINUTES=120
CONVENIENCE_FEE_PER_SEAT=30
TAX_RATE=0.18
WEEKEND_SURCHARGE_RATE=0.10
PRICING_STRATEGY=CATEGORY
HOLD_EXPIRY_JOB_ENABLED=true
HOLD_EXPIRY_JOB_INTERVAL_MS=30000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
