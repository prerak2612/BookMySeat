' =====================================================================
package "domain" {
  abstract class Entity {
    +id: number
    #Entity(id: number)
    +equals(other: Entity): boolean
  }

  enum UserRole {
    CUSTOMER
    ADMIN
  }
  enum SeatCategory {
    REGULAR
    PREMIUM
    RECLINER
  }
  enum ShowStatus {
    SCHEDULED
    CANCELLED
  }
  enum ShowSeatStatus {
    AVAILABLE
    LOCKED
    BOOKED
  }
  enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
    EXPIRED
    FAILED
  }
  enum PaymentMethod {
    CARD
    UPI
    WALLET
  }
  enum PaymentStatus {
    SUCCESS
    FAILED
    REFUNDED
  }

  abstract class User {
    +name: string
    +email: string
    +createdAt: Date
    -passwordHash: string
    +{abstract} role: UserRole
    +{abstract} canManageCatalog(): boolean
    +canAccessBookingOf(ownerId: number): boolean
    +toPublic(): PublicUser
  }
  class Customer {
    +role: UserRole = CUSTOMER
    +canManageCatalog(): boolean = false
  }
  class Admin {
    +role: UserRole = ADMIN
    +canManageCatalog(): boolean = true
  }
  class UserFactory <<Factory>> {
    +{static} create(props: UserProps): User
  }

  class Movie {
    +title: string
    +description: string
    +durationMinutes: number
    +language: string
    +genre: string
    +certificate: string
    +releaseDate: string
    +posterUrl: string | null
    +isActive: boolean
    +occupiedMinutes(cleaningBufferMinutes: number = 15): number
  }

  class Theatre {
    +name: string
    +city: string
    +address: string
    -screens: Screen[]
    +screens(): Screen[]
  }
  class Screen {
    +theatreId: number
    +name: string
    -seats: Seat[]
    -capacityHint: number
    +seats(): Seat[]
    +capacity(): number
  }
  class Seat {
    +screenId: number
    +rowLabel: string
    +seatNumber: number
    +category: SeatCategory
    +label(): string
  }

  class Show {
    +movieId: number
    +screenId: number
    +startTime: Date
    +endTime: Date
    +basePrice: number
    +status: ShowStatus
    +isBookableAt(now: Date): boolean
    +minutesUntilStart(now: Date): number
    +isWeekend(): boolean
  }

  class ShowSeat <<state machine>> {
    +showId: number
    +seatId: number
    +rowLabel: string
    +seatNumber: number
    +category: SeatCategory
    +version: number
    -status: ShowSeatStatus
    -bookingId: number | null
    -lockExpiresAt: Date | null
    +hasExpiredLock(now: Date): boolean
    +isAvailableAt(now: Date): boolean
    +isHeldBy(bookingId: number, now: Date): boolean
    +effectiveStatus(now: Date): ShowSeatStatus
    +lock(bookingId: number, expiresAt: Date, now: Date): void
    +book(bookingId: number, now: Date): void
    +release(): void
  }

  class Booking <<aggregate root>> {
    +reference: string
    +userId: number
    +showId: number
    +subtotal: number
    +totalAmount: number
    +priceBreakdown: PriceLine[]
    +idempotencyKey: string | null
    +expiresAt: Date
    +createdAt: Date
    -status: BookingStatus
    -confirmedAt: Date | null
    -cancelledAt: Date | null
    -seats: BookingSeat[]
    +isHoldExpired(now: Date): boolean
    +assertPayable(now: Date): void
    +confirm(now: Date): void
    +markPaymentFailed(): void
    +expire(): void
    +cancel(now: Date, show: Show, cutoffMinutes: number): CancellationOutcome
    +isCancellable(now: Date, show: Show, cutoffMinutes: number): boolean
    -transitionToTerminal(target: BookingStatus, allowedFrom: BookingStatus[]): void
  }
  class BookingSeat <<value>> {
    +showSeatId: number
    +seatLabel: string
    +category: string
    +price: number
    +isActive: boolean
  }
  class BookingDraft <<value>> {
    +reference: string
    +userId: number
    +showId: number
    +subtotal: number
    +totalAmount: number
    +priceBreakdown: PriceLine[]
    +idempotencyKey: string | null
    +expiresAt: Date
    +seats: BookingSeat[]
  }
  class BookingBuilder <<Builder>> {
    -userId: number
    -showId: number
    -seats: BookingSeat[]
    -expiresAt: Date
    +forUser(userId: number): BookingBuilder
    +forShow(showId: number): BookingBuilder
    +withSeat(seat: BookingSeat): BookingBuilder
    +withPricing(subtotal: number, total: number, lines: PriceLine[]): BookingBuilder
    +withIdempotencyKey(key: string): BookingBuilder
    +holdUntil(expiresAt: Date): BookingBuilder
    +build(): BookingDraft
    +{static} generateReference(): string
  }

  class Payment {
    +bookingId: number
    +amount: number
    +method: PaymentMethod
    +gateway: string
    +transactionRef: string | null
    +failureReason: string | null
    +idempotencyKey: string | null
    -status: PaymentStatus
    -refundedAt: Date | null
    +markRefunded(now: Date): void
  }
}

Entity <|-- User
Entity <|-- Movie
Entity <|-- Theatre
Entity <|-- Screen
Entity <|-- Seat
Entity <|-- Show
Entity <|-- ShowSeat
Entity <|-- Booking
Entity <|-- Payment
User <|-- Customer
User <|-- Admin
UserFactory ..> Customer : creates
UserFactory ..> Admin : creates

Theatre "1" o-- "0..*" Screen : aggregates
Screen "1" *-- "1..*" Seat : composes
Show "0..*" --> "1" Movie : plays
Show "0..*" --> "1" Screen : on
ShowSeat "0..*" --> "1" Show
ShowSeat "0..*" --> "1" Seat
Booking "1" *-- "1..*" BookingSeat : line items
Booking "0..*" --> "1" Show
Booking "0..*" --> "1" User : made by
BookingSeat "0..*" --> "1" ShowSeat
Payment "0..*" --> "1" Booking
BookingBuilder ..> BookingDraft : builds
Booking ..> Show : uses (cancel rules)

